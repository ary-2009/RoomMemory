# Add these variables to your existing services/api/.env; keep your current DB/MQTT/SMTP values.
# Generate a long random JWT secret before any internet deployment.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Used only to create the first admin account. Remove/rotate after first setup.
BOOTSTRAP_SECRET=replace-with-a-different-long-random-secret
