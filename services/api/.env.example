# Local development only. Do not use these sample secrets in production.
PORT=8080
DATABASE_URL=postgres://roommemory:roommemory_local_only@127.0.0.1:5432/roommemory
WEB_ORIGIN=http://localhost:5173
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_TTL=12h
BOOTSTRAP_SECRET=replace-with-a-different-local-bootstrap-secret
# Optional email alerts; leave blank to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_TO=
