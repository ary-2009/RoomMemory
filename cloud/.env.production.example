# Copy this file to .env on the VPS and replace every placeholder.
DOMAIN=roommemory.example.com

# Use a strong random password; URL-encode special characters in DATABASE_URL if needed.
POSTGRES_DB=roommemory
POSTGRES_USER=roommemory
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_DB_PASSWORD
DATABASE_URL=postgres://roommemory:REPLACE_WITH_LONG_RANDOM_DB_PASSWORD@postgres:5432/roommemory

# Generate 32+ random bytes for JWT_SECRET. Keep the same value across restarts.
JWT_SECRET=REPLACE_WITH_64_HEX_CHAR_RANDOM_SECRET
JWT_TTL=12h
# Needed only during first-admin setup. Remove after initial admin exists.
BOOTSTRAP_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET

# MQTT API account password must match the password_file entry for roommemory_api.
MQTT_URL=mqtt://mosquitto:1883
MQTT_USERNAME=roommemory_api
MQTT_PASSWORD=REPLACE_WITH_LONG_RANDOM_MQTT_API_PASSWORD

# Public site origin; Caddy serves frontend and API on the same origin.
WEB_ORIGIN=https://roommemory.example.com
PORT=8080

# Optional email notifications; keep these values private.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@gmail.com
SMTP_PASS=REPLACE_WITH_GMAIL_APP_PASSWORD
SMTP_FROM=your-sender@gmail.com
ALERT_EMAIL_TO=admin@example.com
